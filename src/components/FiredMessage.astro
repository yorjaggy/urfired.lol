---
import { getRandomReason } from '../script/messages.js';

// Get URL parameters from the request URL
const url = new URL(Astro.request.url);

const rawName = url.searchParams.get('n') || '';
const rawCompany = url.searchParams.get('c') || '';

const name = rawName.length <= 10 ? rawName.toUpperCase() : '';
const company = rawCompany.length <= 10 ? rawCompany.toUpperCase() : '';

// Get initial random reason
const initialReason = getRandomReason();
---

<div class="fired-container">
  <div class="message-container">
    <h2 class="header-text">
      {name ? `${name} YOU ARE FIRED BECAUSE...` : 'YOU ARE FIRED BECAUSE...'}
    </h2>
    <h1 id="firing-reason" class="firing-reason">
      {company ? `${company} THINKS ${initialReason}` : initialReason}
    </h1>
    <p class="instruction">Press space or click anywhere to find out why you're fired</p>
  </div>

  <footer class="footer">
    <p class="footer-message">This site was entirely vibe coded in one hour :D</p>
    <nav class="footer-nav">
      <a href="https://github.com/yorjaggy/urfired.lol" target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      <span class="separator">•</span>
      <a href="/docs">
        Documentation
      </a>
      <span class="separator">•</span>
      <a href="/pricing">
        Pricing
      </a>
      <span class="separator">•</span>
      <a href="https://ko-fi.com/yorjaggy" target="_blank" rel="noopener noreferrer">
        ☕ Ko-fi
      </a>
    </nav>
  </footer>
</div>

<script type="module" define:vars={{ name, company }}>
  import { initializeInteractivity } from '/interactivity.js';

  // Make sure the DOM is fully loaded
  window.addEventListener('load', () => {
    initializeInteractivity(name, company);
  });
</script>

<style>
  .fired-container {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    min-height: 100vh;
    padding: 16px;
    background-color: #FF5722; /* Burnt orange */
  }

  .message-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    flex: 1;
    max-width: 800px;
    padding: 0 16px;
  }

  .header-text {
    font-family: var(--font-mono);
    color: white;
    font-size: 1.25rem;
    margin-bottom: 24px;
    letter-spacing: 0.1em;
    font-weight: 600;
  }

  .firing-reason {
    font-family: var(--font-sans);
    color: black;
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0 0 32px 0;
    transition: opacity 0.3s ease;
  }

  .instruction {
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.8);
    font-size: 0.875rem;
    margin-top: 24px;
    letter-spacing: 0.05em;
  }

  .footer {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    text-align: center;
    padding-top: 20px;
  }

  .footer-message {
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
    margin-bottom: 16px;
  }

  .footer-nav {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .footer-nav a {
    font-family: var(--font-mono);
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-nav a:hover {
    color: white;
    text-decoration: underline;
  }

  .separator {
    color: rgba(255, 255, 255, 0.4);
    font-size: 1rem;
  }

  /* Animation classes */
  .fade-out {
    opacity: 0;
  }

  .fade-in {
    opacity: 1;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .firing-reason {
      font-size: 2rem;
    }

    .header-text {
      font-size: 1rem;
    }
  }

  @media (min-width: 1200px) {
    .firing-reason {
      font-size: 4rem;
    }

    .header-text {
      font-size: 1.5rem;
    }
  }
</style>